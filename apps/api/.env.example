NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/karigar_wala

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

ADMIN_JWT_SECRET=changeme-admin-secret

# Used by `npm run seed` to create/update the default admin login.
ADMIN_SEED_EMAIL=admin@karigarsaathi.dev
ADMIN_SEED_PASSWORD=changeme123

# If unset, OTPs are logged via pino instead of sent — lets you test the
# send/verify flow locally without a live Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=

# Delay, in ms, before a "leave a review" reminder is sent after a booking is
# marked completed. Defaults to 24h (86400000) if unset.
REVIEW_REMINDER_DELAY_MS=

# If unset, web push notifications are silently disabled (in-app notifications
# still work). Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY must match apps/web's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
